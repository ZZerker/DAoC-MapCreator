<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MapCreator.Ui.ViewModels"
        xmlns:views="using:MapCreator.Ui.Views"
        xmlns:rendering="using:MapCreator.Classes.Rendering"
        x:Class="MapCreator.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/icon.ico"
        Title="MapCreator"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="12,8"
                Background="{DynamicResource AppPanelBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                <TextBlock Grid.Column="0" Classes="muted" Text="Game" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="{Binding GamePath}" ToolTip.Tip="{Binding GamePath}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,24,0" />
                <TextBlock Grid.Column="2" Classes="muted" Text="Showing maps from" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Column="3" MinWidth="380" MaxWidth="560"
                          ItemsSource="{Binding ZoneBrowser.Folders}" SelectedItem="{Binding ZoneBrowser.SelectedFolder}"
                          PlaceholderText="No render folder" ToolTip.Tip="{Binding ZoneBrowser.ViewedFolder}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="rendering:RenderFolder">
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="4" Content="Rescan" Command="{Binding ZoneBrowser.RefreshFoldersCommand}" Margin="8,0,24,0"
                        ToolTip.Tip="Read the render folders again" />
                <Button Grid.Column="5" x:Name="SettingsButton" Content="Settings">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <views:SettingsView Width="420" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="340" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <views:ZoneBrowserView Grid.Column="0" DataContext="{Binding ZoneBrowser}" />
            <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="{DynamicResource AppBorderBrush}" />
            <TabControl Grid.Column="2" SelectedIndex="{Binding Render.CenterTab}" Padding="0">
                <TabControl.Styles>
                    <Style Selector="TabItem">
                        <Setter Property="FontSize" Value="14" />
                        <Setter Property="MinHeight" Value="32" />
                        <Setter Property="Padding" Value="12,4" />
                    </Style>
                </TabControl.Styles>
                <TabItem Header="Map">
                    <views:MapViewerView DataContext="{Binding MapViewer}" />
                </TabItem>
                <TabItem Header="{Binding Render.ActivityHeader}">
                    <views:RenderView Margin="8" DataContext="{Binding Render}" />
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="3" ResizeDirection="Columns" Background="{DynamicResource AppBorderBrush}" />
            <views:OptionsView Grid.Column="4" DataContext="{Binding Options}" />
        </Grid>

        <Border Grid.Row="2" Padding="12,8" DataContext="{Binding Render}"
                Background="{DynamicResource AppPanelBackground}"
                BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto" x:DataType="vm:RenderViewModel">
                <Button Grid.Column="0" Content="{Binding ButtonText}" Command="{Binding RenderOrCancelCommand}" MinWidth="150" />
                <Grid Grid.Column="1" ColumnDefinitions="*,Auto" Margin="16,0" IsVisible="{Binding HasRun}">
                    <ProgressBar Grid.Column="0" Value="{Binding Progress}" Minimum="0" Maximum="100" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Closing after the running zones finish" Foreground="#E8C547" Margin="0,0,16,0" IsVisible="{Binding IsClosePending}" />
                    <TextBlock Classes="muted" Text="{Binding CountsText}" IsVisible="{Binding HasRun}" />
                    <TextBlock Text="{Binding ElapsedText}" Margin="12,0,0,0" IsVisible="{Binding HasRun}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
