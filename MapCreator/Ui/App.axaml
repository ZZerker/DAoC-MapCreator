<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MapCreator.Ui.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <SolidColorBrush x:Key="AppPanelBackground">#1E1E1E</SolidColorBrush>
        <SolidColorBrush x:Key="AppBorderBrush">#3A3A3A</SolidColorBrush>
        <SolidColorBrush x:Key="AppTextMuted">#8A8A8A</SolidColorBrush>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
        </Style>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,6,0,2" />
        </Style>
        <Style Selector="TextBlock.placeholder">
            <Setter Property="Foreground" Value="{DynamicResource AppTextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Application.Styles>
</Application>
