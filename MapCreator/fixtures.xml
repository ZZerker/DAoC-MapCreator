<?xml version="1.0" standalone="yes"?>
<Fixtures xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="fixtures.xsd">
  <!--
    Overrides for drawing fixtures. Most of the look comes from the game data:
    textures and their coordinates from the models, trees from Treemap.csv.
    Renderers: None, Shaded, Flat, Image.
    texture: map (draw the texture, default), color (texture's average color), none.
    Without a texture a triangle uses the tree color, then color.
    max_size: models no pattern matches, at most this long in world units, use the category.
  -->

  <!-- Don't draw the nif -->
  <FixtureCategory is_default="false">
    <id>None</id>
    <renderer>None</renderer>
    <light min="0.0" max="0.0" direction="1.0,1.0,-1.0">false</light>
    <color>#FFFFFF</color>
    <transparency>0</transparency>
    <shadow color="#000" offset_x="0" offset_y="0" size="1" transparency="25">false</shadow>
  </FixtureCategory>

  <!-- Default Renderer; do not remove/rename -->
  <FixtureCategory is_default="true">
    <id>Building</id>
    <renderer>Shaded</renderer>
    <light min="0.6" max="1.0" direction="1.0,1.0,-1.0">true</light>
    <color>#FFF</color>
    <transparency>0</transparency>
    <shadow color="#000" offset_x="2" offset_y="4" size="3" transparency="25">true</shadow>
  </FixtureCategory>

  <!-- Terrain pieces split into tiles (Delling crater): a shadow outline would draw the tile seams -->
  <FixtureCategory is_default="false">
    <id>Ground</id>
    <renderer>Shaded</renderer>
    <light min="0.6" max="1.0" direction="1.0,1.0,-1.0">true</light>
    <color>#FFF</color>
    <transparency>0</transparency>
    <shadow color="#000" offset_x="0" offset_y="0" size="1" transparency="25">false</shadow>
  </FixtureCategory>

  <!-- Small models like fences, stones, crates and barrels, drawn without shading. Watchtowers start at about 240. -->
  <FixtureCategory is_default="false">
    <id>Decoration</id>
    <renderer>Flat</renderer>
    <light min="0.6" max="1.0" direction="1.0,1.0,-1.0">false</light>
    <color>#FFF</color>
    <max_size>200</max_size>
    <transparency>0</transparency>
    <shadow color="#000" offset_x="0" offset_y="0" size="1" transparency="25">true</shadow>
  </FixtureCategory>

  <!-- Prerendered: Places an image in the map. The image called like the nif must be placed in data/prerendered/objects; do not remove/rename  -->
  <FixtureCategory is_default="false">
    <id>Prerendered</id>
    <renderer>Image</renderer>
    <!-- This will create a light overlay on the image, creates more realistic results -->
    <light min="0.7" max="1.0" direction="1.0,1.0,-1.0">true</light>
    <color>#DDD</color>
    <transparency>0</transparency>
    <shadow color="#000" offset_x="0" offset_y="0" size="1" transparency="25">true</shadow>
  </FixtureCategory>

  <!-- TreeShaded: UI option; do not remove/rename. Trees use their Treemap.csv color, color is the fallback. -->
  <FixtureCategory is_default="false">
    <id>TreeShaded</id>
    <renderer>Shaded</renderer>
    <light min="0.6" max="1.0" direction="1.0,1.0,-1.0">true</light>
    <color>#064c07</color>
    <texture>none</texture>
    <transparency>20</transparency>
    <shadow color="#000" offset_x="0" offset_y="0" size="1" transparency="25">false</shadow>
  </FixtureCategory>

  <!-- TreeImage: UI option, used by default for trees; do not remove/rename. Draws elm1 if a tree has no image. -->
  <FixtureCategory is_default="false">
    <id>TreeImage</id>
    <renderer>Image</renderer>
    <!-- This will create a light overlay on the image, creates more realistic results -->
    <light min="0.5" max="1.0" direction="1.0,1.0,-1.0">true</light>
    <color>#000</color>
    <transparency>40</transparency>
    <shadow color="#000" offset_x="0" offset_y="2" size="4" transparency="55">true</shadow>
  </FixtureCategory>

  <!-- Trees missing in Treemap.csv -->
  <!-- Lamfhota's Sound -->
  <Fixture>
    <pattern>hOldGrove</pattern>
    <category>TreeImage</category>
  </Fixture>
  <!-- Iarnwood -->
  <Fixture>
    <pattern>Iarnwood</pattern>
    <category>TreeImage</category>
  </Fixture>
  <!-- Grenlocks Sound -->
  <Fixture>
    <pattern>creepywebPine</pattern>
    <category>TreeImage</category>
  </Fixture>

  <!-- Effects: mist, fog and glow meshes around towns and zone borders (Silvermine Mts. ghostRealm_mist01) -->
  <Fixture>
    <pattern>mist|fog|glow|effect</pattern>
    <category>None</category>
  </Fixture>

  <!-- Delling crater (zone 153), nine tiles -->
  <Fixture>
    <pattern>^delling0[0-9]</pattern>
    <category>Ground</category>
  </Fixture>

  <!-- Fences and stones -->
  <Fixture>
    <pattern>b-fence[0-9]+</pattern>
    <category>Decoration</category>
  </Fixture>

  <Fixture>
    <pattern>stone[0-9]+</pattern>
    <category>Decoration</category>
  </Fixture>

  <Fixture>
    <pattern>outcrop[0-9]+</pattern>
    <category>Decoration</category>
  </Fixture>

  <Fixture>
    <pattern>NF_b-fence[0-9]+</pattern>
    <category>Decoration</category>
  </Fixture>
</Fixtures>
